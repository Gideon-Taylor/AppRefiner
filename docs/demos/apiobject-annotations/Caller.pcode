/* App class ZZ_AR_DEMO:Caller. Cross-program calls into the classes above. */
import ZZ_AR_DEMO:*;

class Caller
   method ShortNames();
   method Annotations();
end-class;

method ShortNames
   Local Factory &f = create Factory();
   Local Sink &k = create Sink();

   Local Config &c = &f.Get(); /* OK */
   &k.Use(&c); /* OK: used to be a false "Argument 1 should be Config, found &ZZ_AR_DEMO:Config" */
   &k.Use(&f.Get()); /* OK */
   &k.Use(&f.Current); /* OK */
   &k.UseAll(&f.GetAll()); /* OK */
   Local array of Config &arr = &f.GetAll();
   &k.UseAll(&arr); /* OK: used to be a false error */
   &k.Use(create Caller()); /* ERROR (real): a Caller is not a Config */
end-method;

method Annotations
   Local ApiObject &ci = %Session.GetCompIntfc(CompIntfc.USER_PROFILE);
   Local ApiObject &plain;

   Local Svc &svc = create Svc(%Session); /* OK */
   Local Svc &svc2 = create Svc(&ci); /* WARNING: Svc expects &s as Session (annotated); the argument is ComponentInterface */
   &svc.Use(&ci); /* WARNING: Use expects &s as Session (annotated) ... */
   &svc.Use(&plain); /* OK: plain ApiObject passes */

   Local ApiObject &sess = &svc.GetSession();
   &sess.Disconnect(); /* OK: annotated return, &sess is Session */
   &sess.Bogus(); /* ERROR: ... (&sess is Session, assigned on line 32) */
   &svc.Sess.Disconnect(); /* OK: annotated property */

   Local Sub &sub = create Sub();
   &sub.Use(&ci); /* WARNING: inherited from Base.Use's annotation */
   &sub.Get().Disconnect(); /* OK: inherited return annotation */
end-method;
